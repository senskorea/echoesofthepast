# GeoStories — Environment Variables
# Copy to .env only if it does not already exist. Never commit .env.
# Every VITE_ value is public in the browser, even via GitHub Actions secrets.
# NEVER put Gemini, OpenAI or service-role secrets here.
# Leave values blank for catalogue/lesson-only development.

# Supabase project URL (found in Settings → API)
VITE_SUPABASE_URL=

# Supabase publishable key; server/storage policies must enforce access.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Browser-restricted key for the Google Maps JavaScript API
VITE_GOOGLE_MAPS_API_KEY=

# Enable only after deploying/testing the central backend.
VITE_CENTRAL_SERVICES_ENABLED=false
VITE_AI_PROVIDER=gemini

# Provider secrets belong in supabase/functions/.env (local) or Edge Function
# secrets (production). Never set them in browser Settings or VITE_ variables.
